generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  seeker
  referrer
  both
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum RequestType {
  targeted
  open
}

enum RequestStatus {
  open
  matched
  in_progress
  completed
  disputed
  cancelled
}

enum DealStatus {
  pending_payment
  paid
  referral_submitted
  seeker_confirmed
  completed
  disputed
  refunded
}

enum ProofType {
  ats_screenshot
  email_confirmation
  other
}

enum ConfirmedAs {
  referrer
  seeker
}

enum DisputeStatus {
  open
  under_review
  resolved_refund
  resolved_release
}

model User {
  id                 String             @id @default(uuid())
  clerkId            String             @unique @map("clerk_id")
  email              String             @unique
  fullName           String?            @map("full_name")
  avatarUrl          String?            @map("avatar_url")
  userType           UserType?          @map("user_type")
  linkedinUrl        String?            @map("linkedin_url")
  isVerified         Boolean            @default(false) @map("is_verified")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")

  referrerProfile ReferrerProfile?
  seekerProfile   SeekerProfile?
  dealsAsSeeker   Deal[]         @relation("SeekerDeals")
  dealsAsReferrer Deal[]         @relation("ReferrerDeals")
  proofs          ReferralProof[]
  confirmations   Confirmation[]
  disputes        Dispute[]
  reviews         Review[]       @relation("ReviewerReviews")
  reviewsReceived Review[]       @relation("RevieweeReviews")
  notifications   Notification[]
  conversations1  Conversation[] @relation("Participant1")
  conversations2  Conversation[] @relation("Participant2")

  @@map("users")
}

model ReferrerProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  user                User      @relation(fields: [userId], references: [id])
  companyName         String?   @map("company_name")
  jobTitle            String?   @map("job_title")
  workEmail           String?   @map("work_email")
  workEmailVerified   Boolean   @default(false) @map("work_email_verified")
  yearsAtCompany      Int?      @map("years_at_company")
  departments         String[]
  basePriceCents      Int?      @map("base_price_cents")
  bio                 String?
  totalReferrals      Int       @default(0) @map("total_referrals")
  successfulReferrals Int       @default(0) @map("successful_referrals")
  badges              String[]
  avgRating           Decimal?  @map("avg_rating")
  listings            Listing[]

  @@map("referrer_profiles")
}

model SeekerProfile {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  user             User      @relation(fields: [userId], references: [id])
  resumeUrl        String?   @map("resume_url")
  portfolioUrl     String?   @map("portfolio_url")
  targetIndustries String[]  @map("target_industries")
  targetRoles      String[]  @map("target_roles")
  yearsExperience  Int?      @map("years_experience")
  currentLocation  String?   @map("current_location")
  bio              String?
  requests         Request[]

  @@map("seeker_profiles")
}

model Listing {
  id          String          @id @default(uuid())
  referrerId  String          @map("referrer_id")
  referrer    ReferrerProfile @relation(fields: [referrerId], references: [id])
  companyName String          @map("company_name")
  roleTypes   String[]        @map("role_types")
  priceCents  Int             @map("price_cents")
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  deals       Deal[]

  @@map("listings")
}

model Request {
  id             String        @id @default(uuid())
  seekerId       String        @map("seeker_id")
  seeker         SeekerProfile @relation(fields: [seekerId], references: [id])
  requestType    RequestType   @map("request_type")
  targetCompany  String?       @map("target_company")
  targetRole     String?       @map("target_role")
  targetIndustry String?       @map("target_industry")
  budgetCents    Int           @map("budget_cents")
  description    String?
  status         RequestStatus @default(open)
  createdAt      DateTime      @default(now()) @map("created_at")
  expiresAt      DateTime?     @map("expires_at")
  deals          Deal[]

  @@map("requests")
}

model Deal {
  id                    String         @id @default(uuid())
  requestId             String?        @map("request_id")
  request               Request?       @relation(fields: [requestId], references: [id])
  listingId             String?        @map("listing_id")
  listing               Listing?       @relation(fields: [listingId], references: [id])
  seekerId              String         @map("seeker_id")
  seeker                User           @relation("SeekerDeals", fields: [seekerId], references: [id])
  referrerId            String         @map("referrer_id")
  referrer              User           @relation("ReferrerDeals", fields: [referrerId], references: [id])
  agreedPriceCents      Int            @map("agreed_price_cents")
  platformFeeCents      Int            @map("platform_fee_cents")
  referrerPayoutCents   Int            @map("referrer_payout_cents")
  status                DealStatus     @default(pending_payment)
  stripePaymentIntentId String?        @map("stripe_payment_intent_id")
  coinbaseChargeId      String?        @map("coinbase_charge_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  completedAt           DateTime?      @map("completed_at")
  proofs                ReferralProof[]
  confirmations         Confirmation[]
  disputes              Dispute[]
  conversation          Conversation?
  reviews               Review[]

  @@map("deals")
}

model ReferralProof {
  id          String    @id @default(uuid())
  dealId      String    @map("deal_id")
  deal        Deal      @relation(fields: [dealId], references: [id])
  submittedBy String    @map("submitted_by")
  user        User      @relation(fields: [submittedBy], references: [id])
  proofType   ProofType @map("proof_type")
  fileUrl     String    @map("file_url")
  notes       String?
  submittedAt DateTime  @default(now()) @map("submitted_at")

  @@map("referral_proofs")
}

model Confirmation {
  id          String      @id @default(uuid())
  dealId      String      @map("deal_id")
  deal        Deal        @relation(fields: [dealId], references: [id])
  confirmedBy String      @map("confirmed_by")
  user        User        @relation(fields: [confirmedBy], references: [id])
  confirmedAs ConfirmedAs @map("confirmed_as")
  confirmedAt DateTime    @default(now()) @map("confirmed_at")

  @@map("confirmations")
}

model Dispute {
  id         String        @id @default(uuid())
  dealId     String        @map("deal_id")
  deal       Deal          @relation(fields: [dealId], references: [id])
  raisedBy   String        @map("raised_by")
  user       User          @relation(fields: [raisedBy], references: [id])
  reason     String
  status     DisputeStatus @default(open)
  adminNotes String?       @map("admin_notes")
  createdAt  DateTime      @default(now()) @map("created_at")
  resolvedAt DateTime?     @map("resolved_at")

  @@map("disputes")
}

model Conversation {
  id              String   @id @default(uuid())
  dealId          String?  @unique @map("deal_id")
  deal            Deal?    @relation(fields: [dealId], references: [id])
  streamChannelId String   @map("stream_channel_id")
  participant1    String   @map("participant_1")
  user1           User     @relation("Participant1", fields: [participant1], references: [id])
  participant2    String   @map("participant_2")
  user2           User     @relation("Participant2", fields: [participant2], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("conversations")
}

model Review {
  id         String   @id @default(uuid())
  dealId     String   @map("deal_id")
  deal       Deal     @relation(fields: [dealId], references: [id])
  reviewerId String   @map("reviewer_id")
  reviewer   User     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  revieweeId String   @map("reviewee_id")
  reviewee   User     @relation("RevieweeReviews", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}